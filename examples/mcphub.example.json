{
  "mcpServers": {
    "wled": {
      "command": "uvx",
      "args": [
        "--from",
        "/app/binaries/wled-mcp/REPLACE_WITH_VERSIONED_WHEEL.whl",
        "wled-mcp",
        "--transport",
        "stdio",
        "--config",
        "/app/data/wled-mcp/config/devices.toml",
        "--data-dir",
        "/app/data/wled-mcp"
      ]
    }
  }
}
