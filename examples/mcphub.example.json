{
  "mcpServers": {
    "wled": {
      "command": "uvx",
      "args": [
        "--isolated",
        "--python",
        "3.13",
        "--constraints",
        "/app/binaries/wled-mcp/REPLACE_WITH_VERSION/requirements-runtime.txt",
        "--from",
        "/app/binaries/wled-mcp/REPLACE_WITH_VERSION/wled_mcp-REPLACE_WITH_VERSION-py3-none-any.whl",
        "wled-mcp",
        "--transport",
        "stdio",
        "--config",
        "/app/data/wled-mcp/config/devices.toml",
        "--data-dir",
        "/app/data/wled-mcp"
      ],
      "env": {
        "UV_CACHE_DIR": "/app/data/wled-mcp-uv/cache",
        "UV_TOOL_DIR": "/app/data/wled-mcp-uv/tools",
        "UV_PYTHON_INSTALL_DIR": "/app/data/wled-mcp-uv/python"
      }
    }
  }
}
